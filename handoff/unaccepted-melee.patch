+++ b/tests/gameplay_primary_checks.cpp
@@ -0,0 +1,238 @@
+#include "common/gameplay_primary.hpp"
+#include "common/network.hpp"
+#include <cstdlib>
+#include <iostream>
+using namespace ss2vr;
+using namespace ss2vr::network;
+static void check(bool ok, const char *message) {
+    if (!ok) { std::cerr << message << '\n'; std::exit(1); }
+}
+struct Fixture {
+    Input input;
+    GameplayPrimaryProducer producer[2];
+    TriggerGate gate[2];
+    bool physical[2]{};
+    uint32_t serial[2]{};
+    PrimaryIdentity identity[2];
+    Fixture() {
+        input.sequence = 1; input.tickMs = 1000;
+        input.session = input.reference = input.focused = input.headValid = 1;
+        input.primaryActiveMask = 3;
+        for (unsigned h = 0; h < 2; ++h) {
+            input.handValid[h] = input.gripValid[h] = input.primaryInputGeneration[h] = 1;
+            identity[h] = {{7,0,0,0,false}, 10+h, true};
+        }
+    }
+    void next() { ++input.sequence; input.tickMs += 30; }
+    GameplayPrimary sample(unsigned h, bool allowed = true) {
+        return producer[h].sample(input, h, identity[h], 99, input.tickMs, allowed);
+    }
+    PosePacket packet() {
+        PosePacket p;
+        p.clientNonce=11; p.serverNonce=22; p.sequence=uint32_t(input.sequence);
+        p.trackingGeneration=1; p.validMask=7;
+        for (unsigned h=0; h<2; ++h) {
+            auto source = sample(h);
+            const bool fire = gate[h].update(source.value, source.eligible, source.neutral);
+            const bool neutral = samplePrimaryNeutral(source.value, source.eligible, source.fresh,
+                physical[h], serial[h], source.neutral);
+            if (source.eligible) p.primarySampleEligibleMask |= uint8_t(1u<<h);
+            if (neutral) p.primaryNeutralSampleMask |= uint8_t(1u<<h);
+            if (physical[h]) p.physicalDownMask |= uint8_t(1u<<h);
+            if (fire && physical[h]) p.fireMask |= uint8_t(1u<<h);
+            if (source.carrying) p.wheelOrEquipBlockedMask |= uint8_t(1u<<h);
+            p.primaryInputGeneration[h]=source.generation;
+            p.releasedSerial[h]=serial[h]; p.intentEpoch[h]=1;
+            p.requestedWeapon[h]=-1; p.nativeWeaponId[h]=0;
+            p.grip[h]=weaponTracking(input,h);
+        }
+        return p;
+    }
+};
+int main() {
+    Fixture f;
+    check(!f.packet().primaryNeutralSampleMask, "Seed invented neutral");
+    f.next(); auto quiet=f.packet();
+    check(quiet.primaryNeutralSampleMask==3 && !quiet.fireMask, "Independent quiet failed");
+    const auto generation=quiet.primaryInputGeneration[0];
+    PendingIntents client;
+    client.observeSnapshot(quiet);
+    client.requireNeutral(1); // ACK AFTER the last genuine quiet sample.
+    f.next(); f.input.grip[0].p.x=.025f;
+    auto inactiveBand=f.packet();
+    check(!(inactiveBand.physicalDownMask&1) && !(inactiveBand.primaryNeutralSampleMask&1) &&
+          inactiveBand.releasedSerial[0]==quiet.releasedSerial[0], "Inactive hysteresis laundered quiet");
+    client.observeSnapshot(inactiveBand);
+    f.next(); f.input.grip[0].p.x+=.06f;
+    auto rejected=f.packet();
+    check((rejected.fireMask&1) && !client.retain(rejected,1,f.input.tickMs),
+          "PostACK nonquiet gesture retained");
+    f.next(); auto release=f.packet(); client.observeSnapshot(release);
+    check((release.primaryNeutralSampleMask&1) && release.primaryInputGeneration[0]==generation,
+          "Release changed generation or lacked witness");
+    f.next(); f.input.grip[0].p.x+=.06f;
+    auto high=f.packet();
+    check(client.retain(high,1,f.input.tickMs), "New quiet did not restore gesture retention");
+    f.next(); auto low=f.packet();
+    client.observeSnapshot(low);
+    check(!low.fireMask && !low.physicalDownMask, "Gesture failed release");
+    auto transported=low;
+    check(client.apply(transported,f.input.tickMs)==1 && transported.pulseMask==1,
+          "Gesture-only pulse lost behind transport pressure");
+    OrderedPosePolicy authority; Ack ack; PosePacket frozen;
+    check(authority.validation.bindCapability(11,22), "Capability bind failed");
+    check(authority.receive(quiet,1030,ack) && authority.freeze(1030,frozen) &&
+          authority.finishInterval(ack), "Authority neutral failed");
+    check(authority.receive(transported,f.input.tickMs,ack) && authority.freeze(f.input.tickMs,frozen) &&
+          (frozen.fireMask&1) && authority.finishInterval(ack), "Retained gesture failed native frozen intent");
+    client.consume(1);
+    f.next(); auto after=f.packet();
+    check(authority.receive(after,f.input.tickMs,ack) && authority.freeze(f.input.tickMs,frozen) &&
+          !(frozen.fireMask&1) && authority.finishInterval(ack), "Frozen gesture release lost");
+    check(primaryCommandHistoryCompatible(f.producer[0].last, f.producer[0].last,1,1,true) &&
+          nativeCommandQuery(0,1,2,true)==1, "Ordinary release history incompatible");
+    // Manual OR motion: a quiet hand cannot release a still-held manual source.
+    f.next(); f.input.trigger[0]=.8f; auto manual=f.packet();
+    check((manual.fireMask&1) && !(manual.primaryNeutralSampleMask&1), "Manual OR missing");
+    f.next(); f.input.trigger[0]=0; f.input.grip[0].p.x+=.06f;
+    check(f.packet().fireMask&1, "Gesture dropped when manual released");
+    f.next(); f.input.grip[0].p.x+=.06f; f.input.trigger[1]=.8f;
+    check(f.packet().fireMask==3, "Independent dual sources coupled");
+    f.next(); f.input.gripValid[0]=0;
+    auto lost=f.packet();
+    check(!(lost.primarySampleEligibleMask&1) && !(lost.primaryNeutralSampleMask&1) &&
+          lost.primaryInputGeneration[0]>generation && (lost.fireMask&2), "Grip loss fabricated release/coupled hands");
+    f.next(); f.input.gripValid[0]=1;
+    check(!(f.packet().primaryNeutralSampleMask&1), "Grip recovery seed invented neutral");
+    f.next(); f.input.grip[0].p.x+=.06f;
+    check(!(f.packet().fireMask&1), "Grip recovery high bypassed new neutral");
+    f.next(); check(f.packet().primaryNeutralSampleMask&1, "Grip recovery quiet failed");
+    const auto beforeEquip=f.producer[0].stream.generation;
+    f.identity[0].weapon=40; f.next();
+    check(!f.sample(0).eligible && f.producer[0].stream.generation>beforeEquip,
+          "Equip retained old context");
+    // Manual-only native modes need no grip source and retain analog hysteresis.
+    Fixture ordinary; ordinary.identity[0].gesture=false; ordinary.input.gripValid[0]=0;
+    ordinary.packet(); ordinary.next(); ordinary.packet();
+    ordinary.next(); ordinary.input.trigger[0]=.8f;
+    check(ordinary.packet().fireMask&1, "Manual-only mode requires grip");
+    ordinary.next(); ordinary.input.trigger[0]=.4f;
+    check(ordinary.packet().fireMask&1, "Manual hysteresis changed");
+    ordinary.next(); ordinary.input.trigger[0]=.1f;
+    check(ordinary.packet().primaryNeutralSampleMask&1, "Manual release changed");
+    const auto serial=ordinary.serial[0];
+    check(!ordinary.packet().primaryNeutralSampleMask && ordinary.serial[0]==serial,
+          "Duplicate supplied fresh neutral");
+    Fixture ordering;
+    ordering.sample(0); ordering.next(); auto original=ordering.sample(0);
+    check(original.neutral, "Ordering seed failed");
+    --ordering.input.sequence; ordering.input.tickMs-=30;
+    check(!ordering.sample(0).eligible, "Regressed primary accepted");
+    ordering.next(); auto repeated=ordering.sample(0);
+    check(!repeated.fresh && !repeated.neutral, "Replayed primary supplied current neutral");
+    ordering.next(); check(ordering.sample(0).neutral, "Fresh primary after replay failed");
+    const auto beforeGap=ordering.producer[0].stream.generation;
+    ordering.input.tickMs+=150; ++ordering.input.sequence;
+    check(!ordering.sample(0).eligible, "Forward gap supplied motion neutral");
+    ordering.next(); check(ordering.sample(0).neutral &&
+        ordering.producer[0].stream.generation==beforeGap, "Forward gap recovery failed");
+    const auto own=ordering.producer[0].stream.generation;
+    ordering.sample(1); ordering.next(); ordering.sample(1);
+    ordering.identity[1].weapon=80; ordering.next(); ordering.sample(1);
+    check(ordering.sample(0).generation==own, "Other-hand equip changed source generation");
+    GameplayPrimaryProducer exhausted;
+    exhausted.stream.generation=UINT32_MAX;
+    check(!exhausted.sample(ordering.input,0,ordering.identity[0],99,ordering.input.tickMs,true).eligible &&
+          exhausted.stream.generation==0, "Generation exhaustion aliased an old stream");
+    Fixture carry;
+    carry.packet(); carry.next(); carry.packet(); carry.next();
+    carry.input.trigger[0]=.8f; auto heldBeforeCarry=carry.packet();
+    const auto manualGeneration=heldBeforeCarry.primaryInputGeneration[0];
+    auto copied=carry.sample(0);
+    carry.identity[0].gesture=false; carry.identity[0].carrying=true;
+    check(carry.producer[0].narrowToCarry(copied,carry.input,0,carry.identity[0],99),
+          "Late carry narrowing failed");
+    carry.gate[0].down=carry.gate[0].armed && carry.producer[0].manualDown;
+    check(carry.gate[0].update(copied.value,copied.eligible,copied.neutral) &&
+          copied.generation==manualGeneration && !copied.neutral && copied.carrying,
+          "Carry fabricated release or lost command history");
+    check(primaryCommandHistoryCompatible(copied,copied,1,2,false),
+          "Handheld ACK epoch changed original carry command history");
+    carry.next(); auto stillHeld=carry.packet();
+    check((stillHeld.fireMask&1) && stillHeld.primaryInputGeneration[0]==manualGeneration &&
+          (stillHeld.wheelOrEquipBlockedMask&1), "Fresh carry hold lost/manual intent ungated");
+    PendingIntents carryAdmission;
+    auto carriedWire = stillHeld;
+    carryAdmission.observeSnapshot(carriedWire);
+    carryAdmission.filterPrimaryIntents(carriedWire);
+    check(!(carriedWire.fireMask&1) && (stillHeld.fireMask&1),
+          "Handheld filter changed original carry command level");
+    carry.next(); carry.input.trigger[0]=.4f;
+    check(carry.packet().fireMask&1, "Carry manual hysteresis lost");
+    carry.next(); carry.input.trigger[0]=.1f;
+    check(!(carry.packet().fireMask&1), "Carry actual manual release lost");
+    Fixture earlyCarry;
+    earlyCarry.packet(); earlyCarry.next(); earlyCarry.packet(); earlyCarry.next();
+    earlyCarry.input.trigger[0]=.8f; earlyCarry.packet();
+    const auto earlyGeneration=earlyCarry.producer[0].stream.generation;
+    earlyCarry.next(); earlyCarry.identity[0].gesture=false; earlyCarry.identity[0].carrying=true;
+    auto earlyHeld=earlyCarry.packet();
+    check((earlyHeld.fireMask&1) && earlyHeld.primaryInputGeneration[0]==earlyGeneration,
+          "Between-update carry fabricated manual release");
+    Fixture gestureCarry;
+    gestureCarry.packet(); gestureCarry.next(); gestureCarry.packet(); gestureCarry.next();
+    gestureCarry.input.trigger[0]=.4f; gestureCarry.input.grip[0].p.x=.06f;
+    auto gestureHigh=gestureCarry.packet();
+    check(gestureHigh.fireMask&1, "Gesture-only setup failed");
+    auto gestureCopy=gestureCarry.sample(0);
+    const auto beforeGestureCarry=gestureCopy;
+    gestureCarry.identity[0].gesture=false; gestureCarry.identity[0].carrying=true;
+    check(gestureCarry.producer[0].narrowToCarry(gestureCopy,gestureCarry.input,0,gestureCarry.identity[0],99),
+          "Gesture-only carry narrowing failed");
+    gestureCarry.gate[0].down=gestureCarry.gate[0].armed && gestureCarry.producer[0].manualDown;
+    check(!gestureCarry.gate[0].update(gestureCopy.value,gestureCopy.eligible,gestureCopy.neutral) &&
+          !gestureCopy.neutral, "Carry inherited gesture high or fabricated neutral");
+    check(nativeCommandQuery(0,primaryPreviousCommandValue(1,beforeGestureCarry,gestureCopy),2,true)==0,
+          "Removed gesture fabricated a cached command release");
+    PendingIntents carriedPending;
+    check(carriedPending.retain(gestureHigh,1,gestureCarry.input.tickMs), "Carry pending setup failed");
+    gestureCarry.next(); auto carriedPacket=gestureCarry.packet();
+    carriedPending.observeSnapshot(carriedPacket);
+    check(!carriedPending.active(0,gestureCarry.input.tickMs), "Carry retained handheld gesture pulse");
+    // Native reentry may revoke and restore identity, never the source token.
+    Fixture retired;
+    retired.packet(); retired.next(); retired.packet(); retired.next();
+    retired.input.grip[0].p.x=.06f; auto retiredPacket=retired.packet();
+    check(retiredPacket.fireMask&1, "Revocation setup failed");
+    const auto cachedHigh=retired.producer[0].last;
+    const auto unchangedIdentity=retired.producer[0].identity;
+    retired.producer[0].revoke(retired.input,99,retired.input.tickMs);
+    check(retired.producer[0].identity==unchangedIdentity && !retired.producer[0].current(cachedHigh,retired.input),
+          "Identity restoration revived retired cached source");
+    for (bool late : {false,true}) {
+        Fixture manualCarry;
+        manualCarry.identity[0].gesture=false;
+        manualCarry.packet(); manualCarry.next(); manualCarry.packet(); manualCarry.next();
+        manualCarry.input.trigger[0]=.8f; auto before=manualCarry.packet();
+        const auto gen=before.primaryInputGeneration[0];
+        auto entryCaptured=manualCarry.sample(0);
+        manualCarry.identity[0].carrying=true;
+        if (late) {
+            check(manualCarry.producer[0].narrowToCarry(entryCaptured,manualCarry.input,0,manualCarry.identity[0],99) &&
+                  entryCaptured.value>.65f && entryCaptured.generation==gen, "Late manual-only carry entry lost hold");
+        }
+        manualCarry.next(); auto entering=manualCarry.packet();
+        check((entering.fireMask&1) && entering.primaryInputGeneration[0]==gen,
+              "Manual-only carry entry changed source");
+        auto exitCaptured=manualCarry.sample(0);
+        manualCarry.identity[0].carrying=false;
+        if (late) {
+            check(manualCarry.producer[0].narrowToCarry(exitCaptured,manualCarry.input,0,manualCarry.identity[0],99) &&
+                  exitCaptured.value>.65f && exitCaptured.generation==gen, "Late manual-only carry exit lost hold");
+        }
+        manualCarry.next(); auto leaving=manualCarry.packet();
+        check((leaving.fireMask&1) && leaving.primaryInputGeneration[0]==gen,
+              "Manual-only carry exit changed source");
+    }
+    std::cout<<"Gameplay primary/retained/native freeze checks passed\n";
+}
diff --git a/tests/physical_motion_checks.cpp b/tests/physical_motion_checks.cpp
new file mode 100755
--- /dev/null
+++ b/tests/physical_motion_checks.cpp
@@ -0,0 +1,107 @@
+#include "common/physical_motion.hpp"
+#include "common/controls.hpp"
+#include <cstdlib>
+#include <iostream>
+#include <limits>
+using namespace ss2vr;
+static void check(bool ok, const char *message) {
+    if (!ok) { std::cerr << message << '\n'; std::exit(1); }
+}
+int main() {
+    PhysicalMotion left, right;
+    Pose pose{};
+    auto sample = left.sample(pose, 1, 1000, 1000, true);
+    check(!sample.known && !sample.fresh && !sample.down, "First pose invented neutral");
+    sample = left.sample(pose, 2, 1030, 1030, true);
+    check(sample.known && sample.fresh && !sample.down, "Fresh quiet pair unavailable");
+    right.sample(pose, 1, 1000, 1000, true);
+    right.sample(pose, 2, 1030, 1030, true);
+    for (unsigned axis = 0; axis != 3; ++axis) {
+        PhysicalMotion motion;
+        motion.sample({}, 1, 1000, 1000, true);
+        Pose moved{};
+        if (axis == 0) moved.p.x = .06f;
+        if (axis == 1) moved.p.y = .06f;
+        if (axis == 2) moved.p.z = .06f;
+        sample = motion.sample(moved, 2, 1030, 1030, true);
+        check(sample.known && sample.down, "XYZ gesture missing");
+    }
+    pose.p.x = .06f;
+    sample = left.sample(pose, 3, 1060, 1060, true);
+    check(sample.down && !right.down, "Hands coupled");
+    sample = left.sample(pose, 3, 1060, 1070, true);
+    check(sample.known && !sample.fresh && sample.down, "Duplicate changed gesture");
+    pose.p.x += .025f;
+    check(left.sample(pose, 4, 1090, 1090, true).down, "Hysteresis dropped held motion");
+    check(!left.sample(pose, 5, 1120, 1120, true).down, "Quiet motion stayed down");
+    PhysicalMotion rotation;
+    rotation.sample({}, 1, 1000, 1000, true);
+    Pose spun{yaw(.3f), {}};
+    check(rotation.sample(spun, 2, 1030, 1030, true).down, "Rotation gesture missing");
+    spun.q = {-spun.q.x, -spun.q.y, -spun.q.z, -spun.q.w};
+    sample = rotation.sample(spun, 3, 1060, 1060, true);
+    check(sample.known && !sample.down, "Quaternion sign invented motion");
+    for (unsigned axis = 0; axis != 3; ++axis) {
+        PhysicalMotion angular;
+        angular.sample({}, 1, 1000, 1000, true);
+        Pose moved{};
+        const float sine = std::sin(.15f);
+        moved.q.w = std::cos(.15f);
+        if (axis == 0) moved.q.x = sine;
+        if (axis == 1) moved.q.y = sine;
+        if (axis == 2) moved.q.z = sine;
+        check(angular.sample(moved, 2, 1030, 1030, true).down, "XYZ angular gesture missing");
+    }
+    Input tracked;
+    tracked.gripValid[0] = 1;
+    tracked.grip[0].p = {1, 2, 3};
+    PhysicalMotion local;
+    local.sample(weaponTracking(tracked, 0), 1, 1000, 1000, true);
+    tracked.head = {yaw(1.5f), {4, 5, 6}};
+    tracked.hand[0].p.x = 10; // Aim-origin travel is ignored when grip exists.
+    sample = local.sample(weaponTracking(tracked, 0), 2, 1030, 1030, true);
+    check(sample.known && !sample.down, "Head or aim-origin travel invented grip motion");
+    tracked.hand[0].q = yaw(.3f);
+    check(local.sample(weaponTracking(tracked, 0), 3, 1060, 1060, true).down,
+          "Aim orientation lost at grip attachment");
+    PhysicalMotion slow;
+    slow.sample({}, 1, 1000, 1000, true);
+    sample = slow.sample(Pose{{}, {.06f, 0, 0}}, 2, 1060, 1060, true);
+    check(sample.known && !sample.down, "30ms normalization missing");
+    PhysicalMotion replay;
+    replay.sample({}, 10, 1000, 1000, true);
+    replay.sample({}, 11, 1030, 1030, true);
+    check(!replay.sample({}, 9, 970, 1030, true).known && replay.sequence == 11,
+          "Replay became a baseline");
+    check(!replay.sample({}, 10, 1000, 1030, true).known, "Replay invented quiet pair");
+    check(replay.sample({}, 12, 1060, 1060, true).known, "New source failed after replay");
+    sample = left.sample(pose, 6, 1300, 1300, true);
+    check(!sample.known && !sample.fresh, "Gap invented release");
+    sample = left.sample(pose, 6, 1300, 1501, true);
+    check(!sample.known && !left.seeded, "Stale sample admitted");
+    check(!left.sample(pose, 7, 1600, 1599, true).known, "Future sample admitted");
+    left.sample(pose, 7, 1600, 1600, true);
+    check(!left.sample(pose, 8, 1630, 1630, false).known && !left.seeded, "Loss invented release");
+    check(!left.sample(pose, 9, 1660, 1660, true).known, "Recovery reused baseline");
+    Pose jump = pose; jump.p.z += 1;
+    check(!left.sample(jump, 10, 1690, 1690, true).known, "Discontinuity invented gesture or neutral");
+    check(left.sample(jump, 11, 1720, 1720, true).known, "Quiet recovery failed");
+    Pose bad = pose; bad.q.w = 0;
+    check(!left.sample(bad, 12, 1750, 1750, true).known, "Nonunit pose accepted");
+    bad = pose; bad.p.x = std::numeric_limits<float>::infinity();
+    check(!left.sample(bad, 13, 1780, 1780, true).known, "Nonfinite pose accepted");
+    TriggerGate gate;
+    PhysicalMotion context;
+    sample = context.sample({}, 1, 1000, 1000, true);
+    check(!gate.update(sample.down ? 1.f : 0.f, sample.known, sample.fresh && sample.quiet), "Unknown motion armed gate");
+    sample = context.sample({}, 2, 1030, 1030, true);
+    check(!gate.update(sample.down ? 1.f : 0.f, sample.known, sample.fresh && sample.quiet) && gate.armed, "Quiet pair failed rearm");
+    sample = context.sample(Pose{{}, {.06f, 0, 0}}, 3, 1060, 1060, true);
+    check(gate.update(sample.down ? 1.f : 0.f, sample.known, sample.fresh && sample.quiet), "Armed gesture failed");
+    context.reset(); gate = {};
+    sample = context.sample({}, 4, 1090, 1090, true);
+    check(!gate.update(sample.down ? 1.f : 0.f, sample.known, sample.fresh && sample.quiet), "Context reset invented neutral");
+    sample = context.sample(Pose{{}, {.06f, 0, 0}}, 5, 1120, 1120, true);
+    check(sample.down && !gate.update(1.f, sample.known, sample.fresh && sample.quiet), "Postreset high bypassed neutral");
+    std::cout << "LOCAL motion sample checks passed\n";
+}
