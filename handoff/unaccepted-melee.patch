+static bool primaryIdentity(const Snapshot &s, unsigned hand, PrimaryIdentity &out) {
+    if (hand >= 2 || !s.player || !nativeRiderCurrent(s.player, s.rider)) return false;
+    out = {s.rider, s.handle[hand], false};
+    if (!s.rider.handheld()) return s.rider.seated();
