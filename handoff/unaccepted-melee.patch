diff --git a/src/common/gameplay_primary.hpp b/src/common/gameplay_primary.hpp
new file mode 100755
--- /dev/null
+++ b/src/common/gameplay_primary.hpp
@@ -0,0 +1,125 @@
+#pragma once
+#include "controls.hpp"
+#include "physical_motion.hpp"
+#include "rider.hpp"
+
+namespace ss2vr {
+struct GameplayPrimary {
+    float value = 0;
+    uint32_t generation = 0;
+    bool eligible = false, fresh = false, neutral = false, carrying = false, manualDown = false;
+};
+inline bool primaryCommandHistoryCompatible(const GameplayPrimary &before, const GameplayPrimary &after,
+                                             uint32_t beforeEpoch, uint32_t afterEpoch, bool handheld) {
+    return before.eligible && after.eligible && before.generation && before.generation == after.generation &&
+           (!handheld || beforeEpoch == afterEpoch);
+}
+inline float primaryPreviousCommandValue(float previous, const GameplayPrimary &before,
+                                          const GameplayPrimary &after) {
+    return after.carrying && !before.manualDown ? 0.f : previous;
+}
+struct PrimaryIdentity {
+    RiderIdentity rider;
+    uint32_t weapon = 0;
+    bool gesture = false, carrying = false;
+    bool operator==(const PrimaryIdentity &) const = default;
+};
+// Provenance/motion derivation only. TriggerGate and the existing network
+// admission retain all arming/ACK policy; native gameplay retains combat.
+struct GameplayPrimaryProducer {
+    ActionStream stream;
+    PhysicalMotion motion;
+    InputSampleBoundary boundary;
+    PrimaryIdentity identity;
+    uint32_t session = 0, reference = 0, producer = 0, action = 0;
+    uint64_t sequence = 0, tickMs = 0;
+    GameplayPrimary last;
+    bool configured = false, manualDown = false;
+
+    void revoke(const Input &input, uint32_t inputProducer, uint64_t now) {
+        stream.invalidate(); motion.reset(); last = {}; manualDown = false;
+        boundary = {input.session, input.reference, input.sequence, now, inputProducer};
+    }
+    bool current(const GameplayPrimary &captured, const Input &input) const {
+        return stream.active && captured.generation && captured.generation == stream.generation &&
+            input.sequence == sequence && input.tickMs == tickMs &&
+            captured.value == last.value && captured.eligible == last.eligible && captured.carrying == last.carrying &&
+            captured.manualDown == last.manualDown;
+    }
+    // Narrowing to native carry removes gesture contribution but does not
+    // replace an uninterrupted manual source or its command history. Returning
+    // to a gesture-enabled weapon remains an ordinary context boundary.
+    bool narrowToCarry(GameplayPrimary &captured, const Input &input, unsigned hand,
+                       const PrimaryIdentity &native, uint32_t inputProducer) {
+        if (hand >= 2 || !configured || !current(captured, input) || !captured.eligible ||
+            identity.carrying == native.carrying || native.gesture ||
+            identity.rider != native.rider || identity.weapon != native.weapon ||
+            session != input.session || reference != input.reference || producer != inputProducer ||
+            action != input.primaryInputGeneration[hand] || !primaryActionEligible(input, hand) ||
+            input.sequence != sequence || input.tickMs != tickMs || !std::isfinite(input.trigger[hand]))
+            return false;
+        identity = native; motion.reset();
+        captured.value = manualDown || input.trigger[hand] < .2f ? input.trigger[hand] : 0.f;
+        captured.carrying = native.carrying; captured.fresh = captured.neutral = false;
+        last = captured;
+        return true;
+    }
+    GameplayPrimary sample(const Input &input, unsigned hand, const PrimaryIdentity &native,
+                           uint32_t inputProducer, uint64_t now, bool allowed) {
+        if (hand >= 2) return {};
+        const bool carryNarrow = configured && stream.active && identity.carrying != native.carrying &&
+            !native.gesture && identity.rider == native.rider && identity.weapon == native.weapon &&
+            session == input.session && reference == input.reference && producer == inputProducer &&
+            action == input.primaryInputGeneration[hand];
+        if (carryNarrow) {
+            identity = native; motion.reset();
+            last.value = manualDown || input.trigger[hand] < .2f ? input.trigger[hand] : 0.f;
+            last.carrying = native.carrying;
+            last.fresh = last.neutral = false;
+        }
+        const bool changed = !configured || identity != native || session != input.session ||
+            reference != input.reference || producer != inputProducer ||
+            action != input.primaryInputGeneration[hand];
+        if (changed) {
+            revoke(input, inputProducer, now);
+            identity = native; session = input.session; reference = input.reference;
+            producer = inputProducer; action = input.primaryInputGeneration[hand];
+            sequence = tickMs = 0; configured = true;
+        }
+        const bool gesturePose = input.gripValid[hand] && PhysicalMotion::valid(input.grip[hand]) &&
+                                 PhysicalMotion::valid(input.hand[hand]);
+        const bool available = allowed && input.session && input.focused && input.headValid &&
+            input.handValid[hand] && finite(input.hand[hand]) && primaryActionEligible(input, hand) &&
+            std::isfinite(input.trigger[hand]) && input.trigger[hand] >= 0 && input.trigger[hand] <= 1 &&
+            input.sequence && input.tickMs && input.tickMs <= now && now - input.tickMs <= 200 &&
+            (!native.gesture || gesturePose);
+        if (!available) {
+            if (stream.active) revoke(input, inputProducer, now);
+            stream.sample(false); motion.reset(); last = {};
+            return {0, stream.generation, false, false, false};
+        }
+        if (!stream.sample(true)) return {};
+        const auto movement = native.gesture ? motion.sample(weaponTracking(input, hand), input.sequence,
+            input.tickMs, now, true) : PhysicalMotionSample{};
+        if (!boundary.permits(input, now, inputProducer))
+            return {0, stream.generation, false, false, false};
+        const bool newSample = input.sequence > sequence && input.tickMs > tickMs;
+        if (!newSample) {
+            if (input.sequence != sequence || input.tickMs != tickMs)
+                return {0, stream.generation, false, false, false};
+            auto repeated = last; repeated.fresh = repeated.neutral = false;
+            return repeated;
+        }
+        sequence = input.sequence; tickMs = input.tickMs;
+        if (input.trigger[hand] > .65f) manualDown = true;
+        else if (input.trigger[hand] < .2f) manualDown = false;
+        const bool known = !native.gesture || movement.known;
+        const bool quiet = !native.gesture || (movement.fresh && movement.quiet);
+        const float value = native.gesture && movement.down ? 1.f :
+            (native.gesture || native.carrying) && !manualDown && input.trigger[hand] >= .2f ? 0.f : input.trigger[hand];
+        last = {value, stream.generation,
+                known, true, known && quiet && input.trigger[hand] < .2f, native.carrying, manualDown};
+        return last;
+    }
+};
+} // namespace ss2vr
diff --git a/src/common/physical_motion.hpp b/src/common/physical_motion.hpp
new file mode 100755
--- /dev/null
+++ b/src/common/physical_motion.hpp
@@ -0,0 +1,68 @@
+#pragma once
+#include "math.hpp"
+
+namespace ss2vr {
+// A LOCAL-space sampling heuristic, not calibrated XR velocity or a combat
+// timer. The caller owns source/context identity and the existing trigger gate.
+struct PhysicalMotionSample {
+    bool known = false, fresh = false, down = false, quiet = false;
+};
+struct PhysicalMotion {
+    Pose previous{};
+    uint64_t sequence = 0, tickMs = 0;
+    bool seeded = false, down = false;
+    PhysicalMotionSample observation{};
+
+    void reset() { *this = {}; }
+    static bool valid(Pose pose) {
+        if (!finite(pose)) return false;
+        const auto q = pose.q;
+        const double n = double(q.x)*q.x + double(q.y)*q.y + double(q.z)*q.z + double(q.w)*q.w;
+        return n >= .99 && n <= 1.01;
+    }
+    PhysicalMotionSample sample(Pose pose, uint64_t sourceSequence, uint64_t sourceTick,
+                                uint64_t now, bool available) {
+        if (!available || !sourceSequence || !sourceTick || sourceTick > now ||
+            now - sourceTick > 200 || !valid(pose)) {
+            reset();
+            return {};
+        }
+        if (seeded && sourceSequence == sequence && sourceTick == tickMs)
+            return {observation.known, false, observation.down};
+        if (seeded && (sourceSequence <= sequence || sourceTick <= tickMs)) {
+            down = false; observation = {};
+            return {}; // Keep the high-water baseline; replay cannot reseed it.
+        }
+        const bool consecutive = seeded && sourceSequence > sequence && sourceTick > tickMs &&
+                                 sourceTick - tickMs <= 100;
+        const Pose before = previous;
+        const uint64_t elapsed = consecutive ? sourceTick - tickMs : 0;
+        previous = pose; sequence = sourceSequence; tickMs = sourceTick; seeded = true;
+        if (!consecutive) {
+            down = false; observation = {};
+            return {};
+        }
+        const double dx = double(pose.p.x) - before.p.x;
+        const double dy = double(pose.p.y) - before.p.y;
+        const double dz = double(pose.p.z) - before.p.z;
+        const double distance = std::sqrt(dx*dx + dy*dy + dz*dz);
+        const auto a = before.q, b = pose.q;
+        const double na = double(a.x)*a.x + double(a.y)*a.y + double(a.z)*a.z + double(a.w)*a.w;
+        const double nb = double(b.x)*b.x + double(b.y)*b.y + double(b.z)*b.z + double(b.w)*b.w;
+        const double cosine = std::abs(double(a.x)*b.x + double(a.y)*b.y + double(a.z)*b.z + double(a.w)*b.w) /
+                              std::sqrt(na*nb);
+        const double arc = 2 * std::acos(std::clamp(cosine, 0., 1.));
+        // A discontinuity seeds a new baseline and supplies no release witness.
+        if (distance > .75 || arc > 1.8) {
+            down = false; observation = {};
+            return {};
+        }
+        const double scale = 30. / double(elapsed);
+        const double displacement = distance * scale, rotation = arc * scale;
+        if (displacement > .04 || rotation > .18) down = true;
+        else if (displacement < .016 && rotation < .07) down = false;
+        observation = {true, true, down, displacement < .016 && rotation < .07};
+        return observation;
+    }
+};
+} // namespace ss2vr
diff --git a/tests/gameplay_primary_checks.cpp b/tests/gameplay_primary_checks.cpp
