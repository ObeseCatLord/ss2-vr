+    void *weapon = s.handle[hand] ? resolve(s.handle[hand]) : nullptr;
+    if (!weapon) return false;
+    const auto field = [](const void *p, unsigned offset) {
+        uint32_t value; memcpy(&value, static_cast<const uint8_t *>(p) + offset, 4); return value;
+    };
+    if (field(weapon, 0x28) != s.playerHandle || field(weapon, 0xbc) != hand ||
+        (field(weapon, 0x10) & 2)) return false;
